[Unit]
Description=Picer IndexService
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=picer
Group=picer
WorkingDirectory=/opt/picer-index
Environment=PICER_INDEX_DATA_ROOT=/var/lib/picer-index
Environment=PICER_INDEX_SERVICE_PORT=8445
ExecStart=/opt/picer-index/Picer.IndexService
Restart=always
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=12
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/picer-index /var/log/picer-index
StandardOutput=append:/var/log/picer-index/service.log
StandardError=append:/var/log/picer-index/service-error.log

[Install]
WantedBy=multi-user.target
