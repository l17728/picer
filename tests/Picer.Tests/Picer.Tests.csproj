<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit 2.5.3 的 NETStandard.Library 1.6.1 传递链携带版本化 RID 资产，FrameworkReference 启用后触发 NETSDK1206；
         仓库仅支持 Windows x64，无需解析这些 RID -->
    <NoWarn>$(NoWarn);NETSDK1206;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Picer.Core\Picer.Core.csproj" />
    <ProjectReference Include="..\..\server\Picer.IndexService\Picer.IndexService.csproj" />
    <ProjectReference Include="..\..\server\Picer.ModelServer\Picer.ModelServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\semantic-retrieval-acceptance-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
