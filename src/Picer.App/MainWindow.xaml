<Window x:Class="Picer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vms="clr-namespace:Picer.App.ViewModels"
        xmlns:controls="clr-namespace:Picer.App.Controls"
        Title="Picer - 图片管理" Icon="Assets/Picer.ico" Height="720" Width="1200" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" AutomationProperties.Name="主菜单">
            <MenuItem Header="文件(_F)" AutomationProperties.Name="文件菜单">
                <MenuItem Header="添加文件夹" Command="{Binding AddFolderCommand}"/>
                <MenuItem Header="存储设置" Click="StorageSettings_Click"/>
                <Separator/>
                <MenuItem Header="删除所选" Command="{Binding DeleteSelectedFilesCommand}"/>
                <MenuItem Header="备份与恢复" Click="DataProtection_Click"/>
            </MenuItem>
            <MenuItem Header="AI 功能(_A)" AutomationProperties.Name="AI 功能菜单">
                <MenuItem Header="AI 模型设置" Click="CloudVisionSettings_Click"/>
                <MenuItem Header="描述选中照片" Command="{Binding AnalyzeSelectedWithCloudCommand}"/>
                <MenuItem Header="任务中心" Click="CloudVisionTasks_Click"/>
                <Separator/>
                <MenuItem Header="中文语义检索" Click="ClipSemantic_Click"/>
                <MenuItem Header="Florence 运行验证" Click="FlorenceValidation_Click"/>
                <MenuItem Header="本地描述任务" Click="FlorenceBatch_Click"/>
            </MenuItem>
            <MenuItem Header="工具(_T)" AutomationProperties.Name="工具菜单">
                <MenuItem Header="查找重复" Command="{Binding OpenDuplicatesCommand}"/>
                <MenuItem Header="运行组件" Click="RuntimeComponents_Click"/>
                <MenuItem Header="诊断中心" Click="Diagnostics_Click"/>
                <MenuItem Header="扫描视频" Command="{Binding ScanVideosCommand}"/>
            </MenuItem>
        </Menu>
        <!-- Top toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <TextBox x:Name="SearchBox" Width="240" Margin="4,0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchBox_TextChanged"
                         AutomationProperties.Name="搜索图片"
                         ToolTip="搜索文件名或地域；未知地域输入后按 Enter 识别"/>
                <TextBlock Text="媒体：" VerticalAlignment="Center" Margin="6,0,2,0"/>
                <ComboBox x:Name="MediaTypeBox" Width="72" SelectedIndex="0" SelectionChanged="MediaTypeBox_SelectionChanged"
                          AutomationProperties.Name="媒体类型过滤">
                    <ComboBoxItem Content="图片" Tag="image"/>
                    <ComboBoxItem Content="视频" Tag="video"/>
                </ComboBox>
                <CheckBox IsChecked="{Binding IsQuestionMode}" VerticalAlignment="Center" Margin="8,0,6,0"
                          Click="QuestionMode_Click" Cursor="Hand" AutomationProperties.Name="AI 问答开关"
                          ToolTip="当前使用本地规则回答基础问题；后续将在此入口连接已配置的大模型">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AI 问答" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Border x:Name="SwitchTrack" Width="38" Height="20" CornerRadius="10"
                                        Background="#8A8A8A" BorderBrush="#666" BorderThickness="1">
                                    <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Margin="1"
                                             Fill="White" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock x:Name="SwitchState" Text="关" Width="18" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="#555" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#1677D2"/>
                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#0D5EA8"/>
                                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="SwitchState" Property="Text" Value="开"/>
                                    <Setter TargetName="SwitchState" Property="Foreground" Value="#0D5EA8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
                <CheckBox IsChecked="{Binding IsChronologicalAscending}" VerticalAlignment="Center" Margin="6,0"
                          Cursor="Hand" Content="{Binding ChronologicalOrderLabel}"
                          AutomationProperties.Name="全局照片时间顺序开关"
                          ToolTip="开启：最早在上、最新在下；关闭：最新在上、最早在下">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="OrderTrack" Width="34" Height="18" CornerRadius="9" Background="#777">
                                    <Ellipse x:Name="OrderThumb" Width="14" Height="14" Margin="1" Fill="White" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="{TemplateBinding Content}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OrderTrack" Property="Background" Value="#1677D2"/>
                                    <Setter TargetName="OrderThumb" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
                <Button Content="清空" Command="{Binding ClearSearchCommand}" Padding="8,3"/>
                <Button Content="地域搜索" Command="{Binding ResolvePlaceCommand}"
                        CommandParameter="{Binding Text, ElementName=SearchBox}" Padding="8,3"
                        Click="RegionSearch_Click"
                        ToolTip="识别城市、区县或历史地名，并按照片 GPS 范围搜索"/>
                <Separator/>
                <Button Command="{Binding AddFolderCommand}" Content="添加文件夹" Padding="10,3"/>
                <Button Command="{Binding RemoveSourceCommand}" Content="移除源" Padding="8,3"/>
                <Separator/>
                <Button Command="{Binding StartIndexCommand}" Content="增量更新索引" Padding="8,3"
                        ToolTip="扫描目录，仅处理新增或发生变化的文件；未变化照片直接跳过"/>
                <Button Command="{Binding CancelIndexCommand}" Content="取消索引" Padding="8,3"/>
                <Button Command="{Binding VerifyCommand}" Content="检查缺失" Padding="8,3"/>
                <Separator/>
                <Button Command="{Binding OpenDuplicatesCommand}" Content="查找重复" Padding="10,3"/>
                <Button Command="{Binding DeleteSelectedFilesCommand}" Content="删除所选" Padding="10,3" Foreground="#A00000"
                        ToolTip="确认后将原文件移入Windows回收站，并删除索引和缩略图"/>
                <TextBlock Text="{Binding ResultsSummary}" Foreground="#595959">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=MainTabs, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Separator/>
                <TextBlock Text="正在索引..." Foreground="#9C4A00" FontWeight="Bold" 
                           Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVis}}"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Bottom panel: status + output log -->
        <Grid DockPanel.Dock="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StatusBar Grid.Row="0">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <ProgressBar Width="200" Height="12" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="False"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <Button Content="详细日志" Command="{Binding ToggleLogCommand}" Padding="8,1"
                            AutomationProperties.Name="展开或折叠详细日志"/>
                </StatusBarItem>
            </StatusBar>

            <Border Grid.Row="1" Height="130" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Background="#2D2D30" LastChildFill="False">
                        <TextBlock Text="  索引日志" Foreground="#CCC" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="11"/>
                        <Button Content="清空" DockPanel.Dock="Right" Foreground="#AAA"
                                Background="Transparent" BorderThickness="0" Padding="6,1"
                                Command="{Binding ClearOutputCommand}" FontSize="10"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" Background="#1E1E1E" Foreground="#D4D4D4"
                             FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding OutputText, Mode=OneWay}" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Main content with tabs -->
        <Grid Margin="4">
        <TabControl x:Name="MainTabs" SelectedIndex="1" SelectionChanged="MainTabs_SelectionChanged">
            <!-- Tab 1: Directory Browser -->
            <TabItem Header="📁 目录浏览">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TreeView x:Name="DirectoryTreeView" Grid.Row="0" Margin="4" AutomationProperties.Name="目录树"
                              ItemsSource="{Binding DirectoryTree}"
                              SelectedItemChanged="DirectoryTree_SelectedItemChanged" PreviewMouseRightButtonDown="DirectoryTree_PreviewMouseRightButtonDown">
                        <TreeView.ContextMenu><ContextMenu Opened="DirectoryContextMenu_Opened">
                            <MenuItem Tag="directory" Header="分类：仅本目录照片（默认）" Click="DirectoryLocalClassification_Click"/>
                            <MenuItem Tag="directory" Header="分类：包含本目录及所有子目录" Click="DirectoryRecursiveClassification_Click"/>
                            <Separator Tag="directory"/><MenuItem Tag="directory" Header="描述未分类场景…" Click="DescribeUnclassifiedScene_Click"
                                                                 ToolTip="批量描述所选目录中尚未描述的未分类场景；在场景节点上使用时只描述当前场景"/>
                            <MenuItem Tag="directory" Header="重新生成分类锚点" Click="RegenerateDirectoryClassification_Click"/>
                            <MenuItem Tag="scene" Header="编辑场景标题和摘要…" Click="EditSceneDescription_Click"/>
                            <MenuItem Tag="scene" Header="描述此未分类场景…" Click="DescribeUnclassifiedScene_Click"/>
                            <MenuItem Tag="album" Header="删除相册…" Click="DeleteAlbum_Click" Foreground="#A00000"/>
                            <MenuItem Tag="pending-location" Header="解析位置" Click="ParsePendingLocations_Click"/>
                        </ContextMenu></TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vms:DirectoryNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" FontSize="12"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="180"
                                               ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding ImageCount, StringFormat='  ({0})'}" Foreground="#595959" FontSize="10"/>
                                    <TextBlock Text="{Binding ClassificationModeLabel}" Foreground="#9C4A00" FontSize="10"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <Border Grid.Row="1" Margin="4" Padding="8" CornerRadius="4" Background="#EEF5FC"
                            Visibility="{Binding IsLocationEnriching, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="正在通过 GPS 构建地点目录" FontWeight="SemiBold"/>
                            <ProgressBar Height="8" Margin="0,6,0,5" Minimum="0"
                                         Maximum="{Binding LocationProgressMaximum}" Value="{Binding LocationProgressValue}"/>
                            <TextBlock Text="{Binding LocationProgressText}" TextWrapping="Wrap" Foreground="#435466" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <TextBlock Grid.Column="0" Margin="24" TextAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="#595959"
                               Text="尚未添加图片目录。&#x0a;请点击上方“添加文件夹”。"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sources.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDD"/>

                    <DockPanel Grid.Column="2">
                    <Border DockPanel.Dock="Top" Margin="4" Padding="10,7" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1"
                            Visibility="{Binding IsTimelineAlbumSelected, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="按" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Button Content="日" Command="{Binding SetTimelineDayCommand}" Padding="9,3"/>
                                <Button Content="周" Command="{Binding SetTimelineWeekCommand}" Padding="9,3" Margin="3,0,0,0"/>
                                <Button Content="月" Command="{Binding SetTimelineMonthCommand}" Padding="9,3" Margin="3,0,0,0"/>
                                <Button Content="年" Command="{Binding SetTimelineYearCommand}" Padding="9,3" Margin="3,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="← 前一个时间点" Command="{Binding NavigatePreviousTimelineCommand}"
                                    IsEnabled="{Binding CanNavigatePreviousTimeline}" Padding="10,4" Margin="14,0,4,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTimelineAnchor}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TimelinePositionText, StringFormat='  ({0})'}" Foreground="#506579" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="后一个时间点 →" Command="{Binding NavigateNextTimelineCommand}"
                                    IsEnabled="{Binding CanNavigateNextTimeline}" Padding="10,4" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                    <controls:PhotoGrid ItemsSource="{Binding DirectoryDisplayItems}" TimelineMode="{Binding IsTimelineAlbumSelected}"
                                        ScrollToItem="{Binding TimelineScrollTarget}"
                                        SelectedItem="{Binding SelectedImage}"
                                        SelectedItemsTarget="{Binding SelectedImages}"
                                        SelectedInfoText="{Binding SelectedPhotoContext}"
                                        OpenCommand="{Binding OpenSelectedCommand}"
                                        ShowDetailsCommand="{Binding ShowImageInfoCommand}"
                                        EditLocationCommand="{Binding EditSelectedLocationCommand}"
                                        EditTagsCommand="{Binding EditSelectedTagsCommand}"
                                        ShowInExplorerCommand="{Binding ShowInExplorerCommand}"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Search Results -->
            <TabItem Header="🔍 搜索结果">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="4" VerticalAlignment="Center">
                        <TextBlock Text="筛选：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        <DatePicker SelectedDate="{Binding FilterTakenAfter}" Width="125"/>
                        <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        <DatePicker SelectedDate="{Binding FilterTakenBefore}" Width="125"/>
                        <TextBlock Text="最小尺寸" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        <TextBox Text="{Binding FilterMinWidth, UpdateSourceTrigger=LostFocus}" Width="60" ToolTip="最小宽度"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBox Text="{Binding FilterMinHeight, UpdateSourceTrigger=LostFocus}" Width="60" ToolTip="最小高度"/>
                        <TextBlock Text="至" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox Text="{Binding FilterMaxWidth, UpdateSourceTrigger=LostFocus}" Width="60" ToolTip="最大宽度"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBox Text="{Binding FilterMaxHeight, UpdateSourceTrigger=LostFocus}" Width="60" ToolTip="最大高度"/>
                        <TextBlock Text="大小(MB)" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        <TextBox Text="{Binding FilterMinFileSizeMb, UpdateSourceTrigger=LostFocus}" Width="45" ToolTip="最小文件大小MB"/>
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBox Text="{Binding FilterMaxFileSizeMb, UpdateSourceTrigger=LostFocus}" Width="45" ToolTip="最大文件大小MB"/>
                        <ComboBox ItemsSource="{Binding CameraBrands}" SelectedItem="{Binding SelectedCameraBrand}"
                                  Width="130" Margin="6,0,0,0" ToolTip="相机品牌"/>
                        <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Tag.Name"
                                  Width="120" Margin="6,0,0,0" ToolTip="标签"/>
                        <CheckBox Content="包含缺失" IsChecked="{Binding IncludeMissing}" Margin="8,0" VerticalAlignment="Center"/>
                        <Button Content="清除筛选" Command="{Binding ClearFiltersCommand}" Padding="8,3"/>
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,2,8,4">
                        <TextBlock Text="{Binding ActiveFiltersText}" TextWrapping="Wrap" Foreground="#444"/>
                        <TextBlock Text="{Binding MatchExplanation}" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding QuestionAnswerText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsQuestionMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="加载更多" Command="{Binding LoadMoreCommand}"
                            HorizontalAlignment="Center" Padding="18,5" Margin="4"/>
                <controls:PhotoGrid ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}"
                                    SelectedItemsTarget="{Binding SelectedImages}"
                                    SelectedInfoText="{Binding SelectedPhotoContext}"
                                    OpenCommand="{Binding OpenSelectedCommand}"
                                    ShowDetailsCommand="{Binding ShowImageInfoCommand}"
                                    EditLocationCommand="{Binding EditSelectedLocationCommand}"
                                    EditTagsCommand="{Binding EditSelectedTagsCommand}"
                                    ShowInExplorerCommand="{Binding ShowInExplorerCommand}"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="👥 人物">
                <Grid Margin="12" DataContext="{Binding People}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10" Margin="4,0,4,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="检查新照片" Command="{Binding AnalyzeAllCommand}" Padding="12,5" Margin="4,0" ToolTip="已分析的照片会使用缓存跳过"/>
                                <Button Content="更新自动归类" Command="{Binding OrganizeFacesCommand}" Padding="12,5" Margin="4,0"
                                        ToolTip="使用最新已应用阈值匹配已命名人物，并重建待命名候选组；保留人工确认与排除结果"/>
                                <Button Content="人脸精度验证" Click="FaceValidation_Click" Padding="12,5" Margin="4,0"/>
                                <Button Content="取消" Command="{Binding CancelAnalysisCommand}" Padding="12,5" Margin="4,0"/>
                                <Button Content="刷新" Command="{Binding RefreshPageCommand}" Padding="12,5" Margin="4,0"
                                        ToolTip="仅从数据库同步最新人物、候选组和人脸状态，不重新扫描或归类"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="4,0,4,8" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>

                    <GroupBox Grid.Row="2" Header="人物分类" Margin="4" Padding="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <Button Content="待分类人脸" AutomationProperties.Name="待分类人脸" Command="{Binding ShowUnassignedFacesCommand}" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,3"/>
                                <Button Content="不分类" AutomationProperties.Name="不分类" Command="{Binding ShowIgnoredFacesCommand}" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,0,0,8"/>
                                <TextBlock Text="已命名人物" FontWeight="SemiBold" Margin="2,3"/>
                                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                                          DisplayMemberPath="DisplayName" MinHeight="32" Padding="6,3"
                                          AutomationProperties.Name="已命名人物下拉列表"
                                          ToolTip="选择人物后在右侧渐进显示其人脸"/>
                                <Button Content="人物详情 / 重命名 / 合并" Command="{Binding OpenSelectedPersonDetailCommand}"
                                        Padding="10,5" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <TextBlock Text="待命名人物组" FontWeight="SemiBold" Margin="2,3"/>
                                <ListBox x:Name="CandidateClustersList" Height="190" ItemsSource="{Binding CandidateClusters}"
                                         SelectedItem="{Binding SelectedCandidateCluster}" PreviewMouseRightButtonDown="CandidateCluster_PreviewMouseRightButtonDown">
                                    <ListBox.ContextMenu><ContextMenu Opened="CandidateClusterMenu_Opened"/></ListBox.ContextMenu>
                                    <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="3">
                                        <Image Width="48" Height="48" Source="{Binding RepresentativeThumbnailPath}" Stretch="UniformToFill" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"/>
                                    </DockPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="创建为新人物" Command="{Binding NameCandidateClusterCommand}" Padding="8,4" Margin="5,0,0,0"/>
                                    <TextBox Text="{Binding NewPersonName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="新人物名称"
                                             ToolTip="输入姓名后，将所选待命名组确认为新人物"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="归入已有人物" Command="{Binding AssignCandidateClusterToSelectedPersonCommand}"
                                            Padding="8,4" Margin="5,0,0,0"/>
                                    <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding CandidateTargetPerson}"
                                              DisplayMemberPath="DisplayName" ToolTip="选择该候选组应归入的已命名人物"/>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="只新建人物" AutomationProperties.Name="只新建人物"
                                            Command="{Binding CreatePersonCommand}" Padding="8,4" Margin="5,0,0,0"
                                            ToolTip="建立一个空人物分类，之后可在右侧多选人脸并移动过去"/>
                                    <TextBlock Text="单张或跨组整理" VerticalAlignment="Center" Foreground="#666"/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Grid.Column="1" Header="{Binding DisplayedFacesTitle}" Margin="4" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="双击人脸查看关联原图；右击可移动到人物、待分类或不分类。" Foreground="#555" Margin="4,0,4,8"/>
                            <Expander DockPanel.Dock="Bottom" Header="该人物的视频人脸证据" IsExpanded="True" Margin="0,6,0,0">
                                <ListBox ItemsSource="{Binding PersonVideoFaces}" Height="150" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate><DataTemplate><Border Width="130" Margin="4" Padding="4" BorderBrush="#CCC" BorderThickness="1"><StackPanel>
                                        <Image Source="{Binding Thumbnail}" Height="92" Stretch="UniformToFill"/>
                                        <TextBlock Text="{Binding Timestamp}" HorizontalAlignment="Center"/>
                                    </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                            <ListBox x:Name="PeopleFacesList" ItemsSource="{Binding DisplayedFaces}" SelectedItem="{Binding SelectedDisplayedFace}"
                                     SelectionMode="Extended"
                                     AutomationProperties.Name="人物人脸列表" AutomationProperties.HelpText="双击打开关联照片；右击可移动到已有分类、待分类或不分类"
                                     MouseDoubleClick="PeopleFace_DoubleClick" PreviewMouseRightButtonDown="PeopleFace_PreviewMouseRightButtonDown"
                                     PreviewMouseLeftButtonDown="PeopleFace_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="PeopleFace_PreviewMouseMove" PreviewMouseLeftButtonUp="PeopleFace_PreviewMouseLeftButtonUp"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ContextMenu><ContextMenu Opened="PeopleFaceMenu_Opened"/></ListBox.ContextMenu>
                                <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="155" ItemHeight="184"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate><Border Width="145" Margin="5" Padding="5" BorderBrush="#CCC" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Height="112" Background="#EEF2F6">
                                            <Image Source="{Binding FaceThumbnailPath}" Stretch="UniformToFill"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="3" Visibility="{Binding IsAutomaticSuggestion, Converter={StaticResource BoolToVis}}">
                                                <Button Content="是" Padding="7,2" Margin="0,0,3,0" Click="ConfirmSuggestedFace_Click"
                                                        ToolTip="确认自动归类正确"/>
                                                <Button Content="不是" Padding="7,2" Click="RejectSuggestedFace_Click"
                                                        ToolTip="否定当前人物并重新分类"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding SuggestedText}" Foreground="#8A4B08" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ImagePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImagePath}" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="🏷 标签与相册">
                <Grid Margin="12" DataContext="{Binding Semantic}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10" Margin="4,0,4,8">
                        <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap"/>
                    </Border>
                    <GroupBox Grid.Row="1" Header="用户标签" Margin="4" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="180" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="新标签名称"/>
                                <Button Content="添加到当前图片" Command="{Binding AddTagCommand}" Padding="10,4" Margin="6,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Tag.Name"/>
                        </DockPanel>
                    </GroupBox>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <GroupBox Header="本地建议（仅使用已索引元数据，不外发图片）" Margin="4" Padding="10">
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="接受" Command="{Binding AcceptCommand}" Padding="8,2" Margin="3,0"/>
                                            <Button Content="拒绝" Command="{Binding RejectCommand}" Padding="8,2"/>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Center"><Run Text="{Binding TagName}"/><Run Text=" · "/><Run Text="{Binding ConfidenceLabel}"/></TextBlock>
                                    </DockPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                        <GroupBox Header="相册" Margin="4" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="新建相册" Command="{Binding AddAlbumCommand}" Padding="10,4" Margin="6,0,0,0"/>
                                    <TextBox Text="{Binding NewAlbumName, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入相册名称"/>
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding Albums}" SelectedItem="{Binding SelectedAlbum}" DisplayMemberPath="Album.Name"/>
                                <Button Content="将当前图片加入相册" Command="{Binding AddToAlbumCommand}" Padding="8,4" Margin="0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="按时间创建相册" Command="{Binding AutoCreateTimeLineAlbumsCommand}" Padding="8,4" Margin="0,0,6,0"/>
                                    <Button Content="按相机创建相册" Command="{Binding AutoCreateCameraAlbumsCommand}" Padding="8,4"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Text="{Binding StatusText}" Margin="8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="🎬 视频">
                <Grid Margin="10" DataContext="{Binding Video}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="扫描视频" Command="{Binding ScanCommand}" Padding="12,5" Margin="4"/>
                            <Button Content="生成/复用关键帧" Command="{Binding GenerateKeyframesCommand}" Padding="12,5" Margin="4"/>
                            <Button Content="本地音频转写" Command="{Binding TranscribeCommand}" Padding="12,5" Margin="4"/>
                            <Button Content="分析视频人物" Command="{Binding AnalyzePeopleCommand}" Padding="12,5" Margin="4"/>
                            <Button Content="生成融合摘要" Command="{Binding GenerateSummaryCommand}" Padding="12,5" Margin="4"
                                    ToolTip="确认后仅上传去元数据的关键帧拼图及可选转写文本，不上传原视频"/>
                            <Button Content="打开视频" Command="{Binding OpenSelectedCommand}" Padding="12,5" Margin="4"/>
                            <Button Content="定位文件" Command="{Binding RevealSelectedCommand}" Padding="12,5" Margin="4"
                                    ToolTip="打开视频所在目录并选中该文件，便于复制或转发"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="VideoGrid" Grid.Row="1" ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedVideo}"
                              SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="VideoGrid_SelectionChanged"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="打开视频" Command="{Binding OpenSelectedCommand}"/>
                                <MenuItem Header="在文件资源管理器中显示" Command="{Binding RevealSelectedCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="2*"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="3*"/>
                            <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="90"/>
                            <DataGridTextColumn Header="分辨率" Binding="{Binding Resolution}" Width="100"/>
                            <DataGridTextColumn Header="关键帧" Binding="{Binding KeyframeCount}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TabControl Grid.Row="2" Margin="0,8,0,0">
                        <TabItem Header="关键帧">
                            <ListBox ItemsSource="{Binding Frames}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate><Border Width="170" Margin="5" BorderBrush="#CCC" BorderThickness="1" Padding="4"><StackPanel>
                                    <Image Source="{Binding Path}" Height="105" Stretch="Uniform"/><TextBlock Text="{Binding Timestamp}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="人物标注">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding VideoFaceGroups}" SelectedItem="{Binding SelectedVideoFaceGroup}" DisplayMemberPath="DisplayName" Margin="0,0,8,0"/>
                                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="不分类" Command="{Binding IgnoreVideoFaceCommand}" Padding="10,4" Margin="5,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="否" Click="RejectVideoSuggestedFace_Click" Padding="10,4" Margin="5,0,0,0"
                                                ToolTip="否定推荐并选择正确人物、创建新人物或保留待确认"/>
                                        <Button DockPanel.Dock="Right" Content="是" Command="{Binding ConfirmVideoFaceCommand}" Padding="10,4" Margin="5,0,0,0"/>
                                        <Button DockPanel.Dock="Right" Content="归入选择人物" Command="{Binding AssignVideoFaceCommand}" Padding="10,4" Margin="5,0,0,0"/>
                                        <ComboBox ItemsSource="{Binding VideoPeople}" SelectedItem="{Binding SelectedVideoPerson}" DisplayMemberPath="DisplayName" MinWidth="150"/>
                                    </DockPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredVideoFaces}" SelectedItem="{Binding SelectedVideoFace}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate><DataTemplate><Border Width="190" Margin="5" BorderBrush="#CCC" BorderThickness="1" Padding="4"><StackPanel>
                                            <Image Source="{Binding Thumbnail}" Height="110" Stretch="UniformToFill"/>
                                            <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Timestamp}" Foreground="#666"/>
                                        </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="转写与摘要">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <GroupBox Header="视频融合摘要"><TextBox Text="{Binding SummaryText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox>
                                <GroupBox Grid.Column="1" Header="本地语音转写" Margin="8,0"><TextBox Text="{Binding TranscriptText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox>
                                <GroupBox Grid.Column="2" Header="人物时间轴"><TextBox Text="{Binding PeopleTimelineText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
            <Border Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="1" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Width="420">
                    <TextBlock Text="开始建立您的图片索引" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="Picer 只建立索引，不移动、重命名或修改原始图片。" Margin="0,12" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Content="添加照片文件夹" Command="{Binding AddFolderCommand}" Padding="18,8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
