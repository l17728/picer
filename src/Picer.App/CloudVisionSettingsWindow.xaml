<Window x:Class="Picer.App.CloudVisionSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 模型设置" Width="850" Height="690" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#EEF6FF" BorderBrush="#8CB9E8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <StackPanel><TextBlock Text="统一 AI 模型设置" FontSize="17" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="云端功能按用途独立选择服务商和模型。API Key 安全保存到 Windows 凭据管理器，不写入设置文件。可从 OpenCode 同步服务商、接口、模型和密钥。"/></StackPanel>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="云端 AI 功能" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <ListBox x:Name="FeatureBox" SelectionChanged="FeatureBox_SelectionChanged" BorderBrush="#CCC">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding TypeLabel}" Foreground="#3573A8" FontSize="11"/><TextBlock Text="{Binding Description}" Foreground="#666" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="本地 AI 能力" FontWeight="SemiBold" Margin="0,16,0,7"/>
                <Border BorderBrush="#DDD" BorderThickness="1" Padding="10"><StackPanel>
                    <TextBlock Text="AI 问答 · 语言模型（后续接入）"/><TextBlock Text="人脸识别 · YuNet / SFace" Margin="0,6,0,0"/><TextBlock Text="语义搜索 · Chinese-CLIP" Margin="0,6,0,0"/><TextBlock Text="OCR / 图片描述 · Florence" Margin="0,6,0,0"/><TextBlock Text="语音转写 · Whisper" Margin="0,6,0,0"/>
                    <TextBlock Text="这些能力仅在本机运行，不使用云端 API。" Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel></Border>
            </StackPanel>
            <Border Grid.Column="2" BorderBrush="#CCC" BorderThickness="1" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="FeatureTitle" FontSize="18" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="服务商" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ProviderBox" DisplayMemberPath="Name" SelectionChanged="ProviderBox_SelectionChanged"/></Grid>
                    <StackPanel Grid.Row="2" Margin="90,7,0,7"><TextBlock x:Name="EndpointText" Foreground="#666" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="KeyStatusText" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="支持的模型（单选）" FontWeight="SemiBold"/><ListBox x:Name="ModelBox" Margin="0,7,0,0" SelectionMode="Single">
                        <ListBox.ItemTemplate><DataTemplate><RadioButton Content="{Binding DisplayName}" IsHitTestVisible="False" IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected}" Padding="4"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox><TextBlock x:Name="NoModelText" Text="此服务商没有符合当前功能类型的模型。可同步 OpenCode，或检查模型能力分类。" Foreground="#A0442E" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock Text="替换当前服务商的 API Key（留空表示不修改）"/><PasswordBox x:Name="ApiKeyBox" Margin="0,5,0,0"/><Button Content="删除当前服务商密钥" Click="DeleteKey_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel><CheckBox x:Name="EnabledBox" Content="启用云端 AI" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="从 OpenCode 同步" Click="ImportOpenCode_Click" Padding="12,5" Margin="18,0,0,0"/><TextBlock x:Name="ImportStatusText" VerticalAlignment="Center" Foreground="#555" Margin="10,0,0,0"/></WrapPanel>
            <WrapPanel Grid.Column="1"><TextBlock Text="单批上限" VerticalAlignment="Center"/><TextBox x:Name="MaximumBox" Width="60" Margin="7,0,16,0"/><TextBlock Text="日预算 ¥" VerticalAlignment="Center"/><TextBox x:Name="DailyBudgetBox" Width="60" Margin="5,0,12,0"/><TextBlock Text="月预算 ¥" VerticalAlignment="Center"/><TextBox x:Name="MonthlyBudgetBox" Width="70" Margin="5,0,0,0"/></WrapPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0"><CheckBox x:Name="PreciseGpsBox" Content="允许向云端提供精确 GPS（默认只提供本地解析后的地点文字）" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/><Button Content="保存" Click="Save_Click" Padding="16,6" IsDefault="True"/></StackPanel></Grid>
    </Grid>
</Window>
