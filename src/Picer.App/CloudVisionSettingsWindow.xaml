<Window x:Class="Picer.App.CloudVisionSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云端照片分析设置" Width="570" Height="540" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFF7E6" BorderBrush="#E2B55B" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap">云端分析默认关闭。启用后也只分析您主动选择或加入任务的照片，不会自动上传整个照片库。上传副本会缩小并移除EXIF。</TextBlock>
        </Border>
        <CheckBox Grid.Row="1" x:Name="EnabledBox" Content="启用国内云端照片分析" FontWeight="SemiBold" Margin="0,4,0,12"/>
        <Grid Grid.Row="2" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="服务商" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ProviderBox" SelectionChanged="ProviderBox_SelectionChanged">
                <ComboBoxItem Tag="BailianQwen">阿里云百炼 Qwen-VL（推荐）</ComboBoxItem><ComboBoxItem Tag="ZhipuGlm">智谱 GLM-4.6V-Flash（免费试用）</ComboBoxItem>
            </ComboBox></Grid>
        <Grid Grid.Row="3" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="API Key" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><PasswordBox x:Name="ApiKeyBox" ToolTip="已经保存时请留空；仅在新增或替换 Key 时输入。"/><TextBlock x:Name="KeyStatusText" Foreground="#666" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid>
        <Grid Grid.Row="4" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="单批上限" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="MaximumBox" Width="80"/><TextBlock Text=" 张（1–1000）" VerticalAlignment="Center"/></StackPanel></Grid>
        <StackPanel Grid.Row="5" Margin="0,8"><CheckBox x:Name="ComplexModelBox" Content="默认使用增强模型（费用更高；建议仅对复杂照片自动升级）"/>
            <CheckBox x:Name="PreciseGpsBox" Content="向API提供精确坐标（默认只提供逆地理编码后的地点文字）" Margin="0,10,0,0"/>
            <WrapPanel Margin="0,12,0,0"><TextBlock Text="每日预算（元）" VerticalAlignment="Center"/><TextBox x:Name="DailyBudgetBox" Width="70" Margin="8,0,20,0"/><TextBlock Text="每月预算（元）" VerticalAlignment="Center"/><TextBox x:Name="MonthlyBudgetBox" Width="70" Margin="8,0,0,0"/></WrapPanel>
            <TextBlock Text="API Key 使用 Windows 凭据管理器保存，不写入配置文件、数据库或日志。关闭精确坐标后，模型仍可使用本地解析的景区和附近地标。" TextWrapping="Wrap" Foreground="#555" Margin="0,18,0,0"/></StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="删除已保存的Key" Click="DeleteKey_Click" Padding="12,6" Margin="0,0,16,0"/><Button Content="取消" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/><Button Content="保存" Click="Save_Click" Padding="16,6" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
