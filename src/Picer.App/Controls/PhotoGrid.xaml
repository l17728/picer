<UserControl x:Class="Picer.App.Controls.PhotoGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Picer.App.Controls"
             x:Name="Root">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
            <TextBlock Text="{Binding SelectedInfoText, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,18,0" Foreground="#444" TextTrimming="CharacterEllipsis" MaxWidth="650">
                <TextBlock.ToolTip>
                    <ToolTip MaxWidth="700" Placement="Mouse">
                        <TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}" TextWrapping="Wrap"/>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBlock Text="缩略图" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider Width="120" Minimum="96" Maximum="220" Value="{Binding ThumbnailSize, ElementName=Root}"
                    TickFrequency="16" ToolTip="调整缩略图大小"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="8"
                   Foreground="#595959" Text="没有可显示的图片">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=List, Path=Items.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ListBox x:Name="List" Background="#FAFAFA" ItemsSource="{Binding ItemsSource, ElementName=Root}" SelectionChanged="List_SelectionChanged"
                 AutomationProperties.Name="图片网格"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                 SelectionMode="Extended" ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.IsDeferredScrollingEnabled="True"
                 MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="List_PreviewMouseMove" PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                 PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <local:VirtualizingWrapPanel ItemWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGrid}}}"
                                                             ItemHeight="{Binding CardHeight, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGrid}}}"/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Style>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTimelineAnchor}" Value="True">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                    <Border x:Name="StackBack2" BorderBrush="#8FA6BC" BorderThickness="1" Background="#E7EEF5"
                            Margin="11,11,0,0" Visibility="Collapsed"/>
                    <Border x:Name="StackBack1" BorderBrush="#6F8DA8" BorderThickness="1" Background="#F2F6FA"
                            Margin="7,7,4,4" Visibility="Collapsed"/>
                    <Border x:Name="PhotoCard" BorderBrush="#CCC" BorderThickness="1" Padding="4" Margin="3">
                        <StackPanel Width="{Binding ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGrid}}}">
                            <Grid Width="{Binding ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGrid}}}"
                                  Height="{Binding ThumbnailSize, RelativeSource={RelativeSource AncestorType={x:Type local:PhotoGrid}}}">
                                <Border Background="#F0F0F0"/>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="Thumbnail_Loaded" Unloaded="Thumbnail_Unloaded"
                                       AutomationProperties.Name="{Binding FileName}"/>
                                <Border x:Name="VideoPlayOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#B3000000" CornerRadius="24" Width="48" Height="48">
                                    <TextBlock Text="▶" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Border>
                                <Border x:Name="MediaBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Background="#D9323C48" CornerRadius="3" Padding="6,2" Margin="5">
                                    <TextBlock Text="{Binding MediaBadge}" Foreground="White" FontWeight="SemiBold" FontSize="10"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       ToolTip="{Binding Path}"/>
                            <TextBlock Text="{Binding InfoText}" Foreground="#555" FontSize="11" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="BurstBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#CC294A69" CornerRadius="3" Padding="6,3" Margin="7">
                        <TextBlock Text="{Binding BurstBadge}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Button x:Name="BurstToggle" Visibility="Collapsed" Content="{Binding BurstToggleText}"
                            Command="{Binding ToggleBurstCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="28" Height="28" Margin="7" FontWeight="Bold" FontSize="16"
                            ToolTip="{Binding BurstTimeRange}" AutomationProperties.Name="展开或收起连拍照片"/>
                    <Popup x:Name="BurstPopup" IsOpen="{Binding IsBurstExpanded}" Placement="MousePoint"
                           AllowsTransparency="True" StaysOpen="True">
                        <Border Background="White" BorderBrush="#52738F" BorderThickness="1" CornerRadius="5" Padding="10"
                                MaxWidth="760" MaxHeight="560">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding BurstBadge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BurstTimeRange}" Foreground="#526779" Margin="12,0" VerticalAlignment="Center"/>
                                    <Button Content="− 收起" Command="{Binding ToggleBurstCommand}" Padding="9,3"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding BurstMembers}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Click="BurstMember_Click" MouseDoubleClick="BurstMember_DoubleClick" Padding="3" Margin="3"
                                                    Background="White" BorderBrush="#CCD5DE" ToolTip="{Binding Path}">
                                                <StackPanel Width="{Binding ThumbnailSize, Source={x:Reference Root}}">
                                                    <Image Source="{Binding Thumbnail}"
                                                           Width="{Binding ThumbnailSize, Source={x:Reference Root}}"
                                                           Height="{Binding ThumbnailSize, Source={x:Reference Root}}" Stretch="Uniform"
                                                           Loaded="Thumbnail_Loaded" Unloaded="Thumbnail_Unloaded"/>
                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                    <Border x:Name="TimelineAnchor" Visibility="Collapsed" Background="#E7F0FA" BorderBrush="#BCD0E5"
                            BorderThickness="0,0,0,1" Padding="12,8" Margin="3,7,3,3">
                        <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Foreground="#294A69"/>
                    </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsTimelineAnchor}" Value="True">
                            <Setter TargetName="PhotoCard" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TimelineAnchor" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBurstStack}" Value="True">
                            <Setter TargetName="StackBack1" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="StackBack2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BurstBadge" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BurstToggle" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsVideo}" Value="True">
                            <Setter TargetName="VideoPlayOverlay" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MediaBadge" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PhotoCard" Property="BorderBrush" Value="#3D78A8"/>
                            <Setter TargetName="PhotoCard" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem x:Name="DetailsMenuItem" Header="查看图片信息" Click="Details_Click"/>
                    <MenuItem x:Name="EditLocationMenuItem" Header="编辑地点…" Click="EditLocation_Click"/>
                    <MenuItem x:Name="EditTagsMenuItem" Header="编辑标签…" Click="EditTags_Click"/>
                    <Separator/>
                    <MenuItem x:Name="OpenMenuItem" Header="打开" Click="Open_Click"/>
                    <MenuItem Header="在资源管理器中显示" Click="Explorer_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</UserControl>
