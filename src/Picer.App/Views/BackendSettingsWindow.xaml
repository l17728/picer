<Window x:Class="Picer.App.Views.BackendSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="连接索引服务 / 本地模式" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="选择 Picer 的索引工作模式" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="远程 GUI 无需本地模型、Python、CUDA 或视频工具。只有点击验证才连接服务器；保存后重启，不会启动扫描或模型任务。" TextWrapping="Wrap" Margin="0,8,0,14"/>
        <RadioButton x:Name="LocalModeBox" Content="本地模式（本机索引）" GroupName="Mode" Checked="Mode_Checked" Margin="0,4"/>
        <RadioButton x:Name="RemoteModeBox" Content="远程模式（HTTPS 索引服务）" GroupName="Mode" Checked="Mode_Checked" Margin="0,4"/>
        <StackPanel x:Name="ConnectionFields" Margin="0,12,0,0">
            <Button Content="登录照片空间 / 导入设备认证文件…" Click="Account_Click" HorizontalAlignment="Left" Padding="16,6" Margin="0,0,0,12"/>
            <TextBlock x:Name="AccountStatusText" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Expander Header="旧版服务：共享令牌与证书">
            <StackPanel>
            <TextBlock Text="HTTPS 服务地址（由管理员提供，包含端口）"/>
            <TextBox x:Name="IpBox" Padding="6" AutomationProperties.Name="HTTPS 服务地址"/>
            <TextBlock Text="访问令牌" Margin="0,8,0,0"/>
            <PasswordBox x:Name="TokenBox" Padding="6" AutomationProperties.Name="访问令牌"/>
            <TextBlock Text="证书 SHA-256 指纹（验证时自动获取，请与管理员核对）" Margin="0,8,0,0"/>
            <TextBox x:Name="PinBox" IsReadOnly="True" TextWrapping="Wrap" Padding="6" AutomationProperties.Name="证书公钥指纹"/>
            <TextBlock Text="请通过可信渠道核对地址和指纹。令牌使用当前 Windows 用户加密保存。验证检查健康及只读访问权限，不启动扫描或分析。" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Button x:Name="VerifyButton" Content="验证连接" Click="Verify_Click" HorizontalAlignment="Left" Padding="16,6" Margin="0,8,0,0"/>
            </StackPanel>
            </Expander>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="保存并重启" Click="Save_Click" Padding="16,6" IsDefault="True"/></StackPanel>
    </StackPanel>
</Window>
