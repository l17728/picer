<Window x:Class="Picer.App.Views.BackendSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="连接模式" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="选择 Picer 的索引工作模式" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="本地模式使用本机索引；远程模式使用同一个 GUI 连接远程 IndexService。切换后程序会自动重启。" TextWrapping="Wrap" Margin="0,8,0,14" Foreground="#555"/>
        <RadioButton x:Name="LocalModeBox" Content="本地模式（本机 SQLite）" GroupName="Mode" Checked="Mode_Checked" Margin="0,4"/>
        <RadioButton x:Name="RemoteModeBox" Content="远程模式（HTTPS IndexService）" GroupName="Mode" Checked="Mode_Checked" Margin="0,4"/>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="IndexService IP" VerticalAlignment="Center"/><TextBox x:Name="IpBox" Grid.Column="1" Padding="6" ToolTip="例如 124.156.193.122"/></Grid>
        <TextBlock Text="端口和 HTTPS 路径由程序自动组装为 https://IP:8445。令牌和证书读取 service-endpoint.json。" TextWrapping="Wrap" Foreground="#777" Margin="0,8,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0"/><Button Content="保存并重启" Click="Save_Click" Padding="16,6" IsDefault="True"/></StackPanel>
    </StackPanel>
</Window>
