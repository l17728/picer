<Window x:Class="Picer.App.Views.ServiceBrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Picer.App.Controls"
        xmlns:local="clr-namespace:Picer.App.ViewModels"
        Title="图库浏览（索引服务）" Width="960" Height="680" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox x:Name="SearchBox" Width="320" Padding="0,4"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="搜索图片">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="搜索" Command="{Binding SearchCommand}" Margin="8,0" Padding="14,4"/>
            <Button Content="加载更多" Command="{Binding LoadMoreCommand}" Padding="14,4"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#D5DDE7" BorderThickness="1" Margin="0,0,10,0" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="目录浏览" FontSize="16" FontWeight="SemiBold" Margin="4,2,4,8"/>
                    <TreeView x:Name="SourcesTree" ItemsSource="{Binding Sources}" SelectedItemChanged="SourcesTree_SelectedItemChanged" AutomationProperties.Name="远程目录树">
                        <TreeView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="📁" Margin="0,0,5,0"/><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding ImageCount, StringFormat=（{0}）}" Foreground="#777" Margin="5,0,0,0"/></StackPanel></DataTemplate></TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
            <ListBox Grid.Column="1" x:Name="Photos" ItemsSource="{Binding Items}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 AutomationProperties.Name="图片网格">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="180" Margin="6">
                        <StackPanel.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.OpenOriginalCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                        </StackPanel.InputBindings>
                        <Image Height="135" Source="{Binding Thumbnail}" Stretch="Uniform"/>
                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="#555"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
