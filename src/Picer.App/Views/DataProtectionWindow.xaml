<Window x:Class="Picer.App.Views.DataProtectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="备份、恢复与空间管理" Width="820" Height="590" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Background="#FFF7E6" BorderBrush="#E2B96F" BorderThickness="1" Padding="10" Margin="0,0,0,10"><TextBlock TextWrapping="Wrap" Text="备份包含数据库、标签、人物确认、人工验证真值和本地设置，不包含原照片、密码及可重新生成的缓存。恢复前会验证格式与数据库完整性，并自动保留恢复前快照。"/></Border>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="当前数据目录" FontWeight="Bold"/><TextBox x:Name="RootText" IsReadOnly="True" Margin="0,3,0,8"/>
      <WrapPanel><Button x:Name="BackupButton" Content="创建备份…" Click="Backup_Click" Padding="14,6"/><Button x:Name="RestoreButton" Content="校验并恢复…" Click="Restore_Click" Padding="14,6" Margin="8,0"/><Button x:Name="MigrateButton" Content="迁移数据目录…" Click="Migrate_Click" Padding="14,6"/><Button Content="刷新空间占用" Click="Refresh_Click" Padding="14,6" Margin="8,0"/></WrapPanel>
      <ProgressBar x:Name="Progress" Height="12" Margin="0,10,0,4" IsIndeterminate="False"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock Text="空间占用" FontWeight="Bold" FontSize="15"/>
    </StackPanel>
    <ListView x:Name="Areas"><ListView.View><GridView><GridViewColumn Header="类别" Width="130" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/><GridViewColumn Header="位置" Width="520" DisplayMemberBinding="{Binding Path}"/></GridView></ListView.View></ListView>
  </DockPanel>
</Window>
