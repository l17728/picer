<Window x:Class="Picer.App.Views.IndexServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="索引服务状态" Width="680" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="索引服务"/>
        <TextBlock x:Name="ModeText" Margin="0,10,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="TargetText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555"/>
        <TextBlock x:Name="HealthText" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <GroupBox x:Name="AgentBox" Header="本机原图代理（远程查看原图/视频）" Margin="0,12,0,0">
            <StackPanel Margin="8">
                <CheckBox x:Name="AgentEnabledBox" Content="索引同步后保持代理运行"/>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="IndexService IP" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="AgentIpBox" Width="180"/>
                    <Button x:Name="AgentButton" Content="启动代理" Click="Agent_Click" Margin="8,0,0,0" Padding="10,3"/>
                </DockPanel>
                <TextBlock x:Name="AgentStatusText" Foreground="#555" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
        <WrapPanel Margin="0,12,0,0">
            <Button Content="切换本地/远程模式…" Click="SwitchMode_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="SyncButton" Content="上传到我的照片空间…" Click="Sync_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="PauseSyncButton" Content="暂停上传" Click="PauseSync_Click" Visibility="Collapsed" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="BrowseButton" Content="浏览图库" Click="Browse_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="ProbeButton" Content="测试连接" Click="Probe_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="关闭" Click="Close_Click" Padding="14,4"/>
        </WrapPanel>
        <Expander Header="旧版服务兼容" Margin="0,10,0,0">
            <Button Content="使用已有共享令牌同步旧版服务" Click="LegacySync_Click" Padding="10,4" HorizontalAlignment="Left"/>
        </Expander>
    </StackPanel>
</Window>
