<Window x:Class="Picer.App.Views.IndexServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="索引服务状态" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="索引服务"/>
        <TextBlock x:Name="ModeText" Margin="0,10,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="TargetText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555"/>
        <TextBlock x:Name="HealthText" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="BrowseButton" Content="浏览图库" Click="Browse_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="ProbeButton" Content="测试连接" Click="Probe_Click" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="关闭" Click="Close_Click" Padding="14,4"/>
        </WrapPanel>
    </StackPanel>
</Window>
