<Window x:Class="Picer.App.Views.FlorenceValidationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Florence-2 本地描述、OCR 与运行验证" Width="1000" Height="760" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock Text="验证随包 Florence-2-base-ft INT8 四子模型。CPU 与 DirectML 都必须真实加载；视觉编码器执行冷态和热态推理。" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="验证不会联网，也不会上传图片。DirectML 任一子模型不兼容时不会自动启用 GPU。" Margin="0,4,0,0"/></StackPanel></Border>
    <WrapPanel DockPanel.Dock="Top"><Button x:Name="RunButton" Content="运行 CPU + DirectML 验证" Click="Run_Click" Padding="15,6"/><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Padding="15,6" Margin="8,0"/><Button Content="保存推荐选择" Click="Save_Click" Padding="15,6"/><TextBlock x:Name="SelectedText" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0"/></WrapPanel>
    <ProgressBar DockPanel.Dock="Top" x:Name="Progress" Height="12" Margin="0,10,0,4" IsIndeterminate="False"/><TextBlock DockPanel.Dock="Top" x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Grid><Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#CCC" BorderThickness="1" Padding="4"><Image x:Name="Preview" Stretch="Uniform"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0"><WrapPanel><Button Content="选择图片…" Click="ChooseImage_Click" Padding="12,5"/><ComboBox x:Name="TaskBox" Width="150" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="简短描述"/><ComboBoxItem Content="详细描述"/><ComboBoxItem Content="OCR 文字识别"/></ComboBox><Button x:Name="InferButton" Content="完全离线运行" Click="Infer_Click" Padding="12,5"/><Button x:Name="InferCancelButton" Content="取消任务" Click="InferCancel_Click" IsEnabled="False" Padding="12,5" Margin="8,0"/></WrapPanel><TextBlock x:Name="ImagePathText" TextWrapping="Wrap" Foreground="#666" Margin="0,8,0,4"/><TextBox x:Name="InferenceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="105" FontSize="14"/><WrapPanel Margin="0,6,0,0"><TextBlock Text="期望文字：" VerticalAlignment="Center"/><TextBox x:Name="ExpectedText" Width="300"/><ComboBox x:Name="QualityBox" Width="120" Margin="8,0" SelectedIndex="0"><ComboBoxItem Content="准确"/><ComboBoxItem Content="部分准确"/><ComboBoxItem Content="不准确"/></ComboBox><Button Content="保存质量标注" Click="SaveEvaluation_Click" Padding="10,3"/></WrapPanel></StackPanel>
      </Grid>
      <DataGrid Grid.Row="1" x:Name="Results" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="提供程序" Binding="{Binding Provider}" Width="100"/><DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="130"/><DataGridCheckBoxColumn Header="成功" Binding="{Binding Loaded}" Width="60"/><DataGridTextColumn Header="加载 ms" Binding="{Binding LoadText}" Width="85"/><DataGridTextColumn Header="冷态 ms" Binding="{Binding ColdText}" Width="85"/><DataGridTextColumn Header="热态 ms" Binding="{Binding WarmText}" Width="85"/><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
    </Grid>
  </DockPanel>
</Window>
