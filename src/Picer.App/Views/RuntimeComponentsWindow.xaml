<Window x:Class="Picer.App.Views.RuntimeComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线运行组件" Width="900" Height="570" MinWidth="720" MinHeight="440" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Picer 自包含运行环境"/>
            <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Text="以下模型和工具随发布包提供，运行时不联网下载。完整校验会读取文件并核对固定 SHA-256；自检会实际加载模型并启动工具。"/>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="Components" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="组件" Binding="{Binding Spec.Name}" Width="2*"/>
                <DataGridTextColumn Header="许可证" Binding="{Binding Spec.License}" Width="120"/>
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="130"/>
                <DataGridTextColumn Header="发布路径" Binding="{Binding Spec.RelativePath}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" x:Name="Details" Margin="0,8" TextWrapping="Wrap" Foreground="#555"/>
        <DockPanel Grid.Row="3">
            <ProgressBar x:Name="Progress" Width="260" Height="14" Minimum="0" Maximum="100" DockPanel.Dock="Right"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="完整校验" Click="Verify_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="运行自检" Click="SelfTest_Click" Padding="12,6"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
