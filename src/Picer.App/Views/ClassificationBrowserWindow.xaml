<Window x:Class="Picer.App.Views.ClassificationBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Picer.App.Controls"
        Title="照片分类与审核" Width="1280" Height="820" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10" Margin="0,0,0,8">
      <DockPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="正在加载分类信息…"/>
        <WrapPanel DockPanel.Dock="Right">
          <Button Content="增量扫描" Click="Scan_Click" Padding="12,4" Margin="4,0"/>
          <Button Content="刷新" Click="Refresh_Click" Padding="12,4" Margin="4,0"/>
          <Button Content="开始处理" Click="Start_Click" Padding="12,4" Margin="4,0"/>
          <Button Content="加载更多" Click="LoadMore_Click" Padding="12,4" Margin="4,0"/>
        </WrapPanel>
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#D6DCE5" BorderThickness="1" Padding="8" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="分类信息" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <CheckBox x:Name="IncludeSuggestions" Content="包含待确认建议" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,2"/>
            <CheckBox x:Name="IncludeLegacy" Content="包含历史分类" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Margin="0,2"/>
          </StackPanel>
          <TreeView x:Name="LabelTree" SelectedItemChanged="LabelTree_SelectedItemChanged" AutomationProperties.Name="分类树"/>
        </DockPanel>
      </Border>
      <DockPanel Grid.Column="1">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="选择后：" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button x:Name="ConfirmClassificationButton" Content="确认分类" Tag="confirm" Click="Decision_Click" Padding="12,4" Margin="4,0" IsEnabled="False"/>
          <Button x:Name="RejectClassificationButton" Content="不是此类" Tag="reject" Click="Decision_Click" Padding="12,4" Margin="4,0" IsEnabled="False"/>
          <Button Content="全选当前页" Click="SelectAll_Click" Padding="12,4" Margin="4,0"/>
          <Button Content="清除选择" Click="ClearSelection_Click" Padding="12,4" Margin="4,0"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Feedback" Margin="0,8,0,0" Foreground="#555"/>
        <ListBox x:Name="Photos" MouseDoubleClick="Photos_DoubleClick" ScrollViewer.ScrollChanged="Photos_ScrollChanged" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="210" ItemHeight="230"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate>
            <Border BorderBrush="#D6DCE5" BorderThickness="1" Padding="6" Margin="4" Background="White">
              <StackPanel>
                <CheckBox Content="选择" IsChecked="{Binding Selected,Mode=TwoWay}"/>
                <Image Width="188" Height="150" Stretch="Uniform" controls:ThumbnailPresenter.Item="{Binding Preview}"/>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Labels}" TextWrapping="Wrap" Foreground="#555" FontSize="11"/>
              </StackPanel>
            </Border>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
