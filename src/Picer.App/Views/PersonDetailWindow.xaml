<Window x:Class="Picer.App.Views.PersonDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="人物详情" Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Summary" Foreground="#555" Margin="0,4,0,0"/>
                    <DockPanel Margin="0,8,12,0">
                        <Button DockPanel.Dock="Right" Content="保存描述" Click="SaveDescription_Click" Padding="10,4" Margin="6,0,0,0"/>
                        <TextBox x:Name="DescriptionBox" MinWidth="260" ToolTip="用户可修改的人物说明，例如关系、身份或备注"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="NameBox" Width="140" Margin="4" ToolTip="人物显示名称"/>
                    <Button Content="重命名" Click="Rename_Click" Padding="10,4" Margin="4"/>
                    <TextBox x:Name="AliasBox" Width="140" Margin="4" ToolTip="关系或别名，例如老婆"/>
                    <Button Content="添加别名" Click="AddAlias_Click" Padding="10,4" Margin="4"/>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox x:Name="MergeTarget" Width="160" DisplayMemberPath="DisplayName" Margin="4"/>
                <Button Content="合并到所选人物" Click="Merge_Click" Padding="10,4" Margin="4"
                        ToolTip="将当前人物的已确认人脸和别名合并到目标人物；操作前会再次确认"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="Aliases" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ComboBox x:Name="AliasSelection" Width="150" AutomationProperties.AutomationId="PersonAliasSelection"
                              ToolTip="选择要移除的别名；人物本名保持不变"/>
                    <Button Content="移除所选别名" Click="RemoveAlias_Click" Padding="10,4" Margin="6,0,0,0"
                            AutomationProperties.AutomationId="RemovePersonAlias"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="时间与场景" Margin="0,0,8,0" Padding="6">
                <ListBox x:Name="SceneGroups" SelectionChanged="SceneGroups_SelectionChanged">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Margin="3,5">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" Foreground="#666" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <ListBox Grid.Column="1" x:Name="Photos" MouseDoubleClick="Photos_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate>
                    <Border Width="180" Margin="5" Padding="5" BorderBrush="#CCC" BorderThickness="1">
                        <StackPanel><Image Source="{Binding ThumbPath}" Height="120" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TimeText}" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="Status" Margin="0,8,0,0" Foreground="#555" TextWrapping="Wrap"/>
    </Grid>
</Window>
