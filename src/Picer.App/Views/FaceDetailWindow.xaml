<Window x:Class="Picer.App.Views.FaceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="照片中的人物" Width="1100" Height="760" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#AAA" BorderThickness="1" Background="#222" Margin="0,0,10,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Grid x:Name="ImageStage">
                        <Image x:Name="Photo" Stretch="Fill"/>
                        <Canvas x:Name="FaceCanvas" Background="Transparent"/>
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="选择人脸后确认或纠错。所有操作只更新人物索引，不修改照片。"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <ComboBox x:Name="PersonPicker" DisplayMemberPath="DisplayName" Margin="0,0,0,6"/>
                <Button Content="确认为所选人物" Click="Confirm_Click" Padding="8,5" Margin="0,2"/>
                <Button Content="不是当前建议/人物" Click="Reject_Click" Padding="8,5" Margin="0,2"/>
                <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#555"/>
            </StackPanel>
            <ListBox x:Name="FaceList" SelectionChanged="FaceList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock FontWeight="SemiBold"><Run Text="人脸 #"/><Run Text="{Binding DisplayOrdinal}"/></TextBlock>
                            <TextBlock Text="{Binding IdentityText}" Foreground="#555"/>
                            <TextBlock Text="{Binding ConfidenceText}" Foreground="#777" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
