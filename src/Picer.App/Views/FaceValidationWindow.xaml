<Window x:Class="Picer.App.Views.FaceValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="人脸精度验证" Width="1080" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="SFace 同人阈值">
                <StackPanel Margin="14">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="使用已确认人物标定 SFace"/>
                    <TextBlock Margin="0,8,0,12" TextWrapping="Wrap"
                               Text="先在人物页完成至少 5 位成员、每人至少 20 张不同照片的逐脸确认。程序只使用已确认归属，不使用自动建议作为真值。"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CalibrateSFaceButton" Content="计算推荐阈值与误识率" Click="CalibrateSFace_Click" Padding="14,7"/>
                        <Button x:Name="ApplySFaceThreshold" Content="应用到人物自动匹配" Click="ApplySFaceThreshold_Click"
                                Padding="14,7" Margin="8,0,0,0" IsEnabled="False"/>
                        <Button x:Name="TrainFaceButton" Content="提交训练任务" Click="TrainFace_Click"
                                Padding="14,7" Margin="8,0,0,0" ToolTip="提交后由统一模型平台后台训练；完成后需用户确认才应用制品"/>
                        <Button x:Name="CancelTrainingButton" Content="取消训练" Click="CancelTraining_Click"
                                Padding="14,7" Margin="8,0,0,0" IsEnabled="False"/>
                        <Button x:Name="RollbackTrainingButton" Content="回滚上一版" Click="RollbackTraining_Click"
                                Padding="14,7" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Border x:Name="SFaceProgressPanel" Visibility="Collapsed" Background="#E7F2FF" BorderBrush="#4C87C2"
                            BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SFaceProgressText" Text="准备计算…" FontWeight="SemiBold" FontSize="14"
                                       Foreground="#173E63" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="SFaceProgress" Height="18" Minimum="0" Maximum="100"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="12" Margin="0,14,0,0">
                        <TextBlock x:Name="SFaceResult" Text="尚未计算" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="人物学习报告">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="生成只读报告" Click="GenerateReport_Click" Padding="14,7"/>
                        <Button Content="导出 JSON" Click="ExportReport_Click" Padding="14,7" Margin="8,0,0,0"/>
                        <Button Content="刷新训练历史" Click="RefreshTrainingHistory_Click" Padding="14,7" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,12,0,0"><DataGrid x:Name="TrainingHistory" DockPanel.Dock="Bottom" Height="150" AutoGenerateColumns="True" IsReadOnly="True"/><TextBox x:Name="ReportText" Margin="0,0,0,8" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/></DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="YuNet 漏检评估">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Margin="2,2,2,8"
                               Text="为每张照片填写人工确认的人脸数；场景可填写侧脸、儿童、合影、弱光、旧照片等，多个标签用逗号分隔。建议累计标注 500–1000 张。"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="LoadYuNetButton" Content="加载最多 1000 张" Click="LoadYuNet_Click" Padding="10,5" Margin="2"/>
                        <Button x:Name="AnalyzeYuNetButton" Content="扫描已加载照片" Click="AnalyzeYuNet_Click" Padding="10,5" Margin="2"/>
                        <Button x:Name="SaveYuNetButton" Content="保存人工标注" Click="SaveYuNet_Click" Padding="10,5" Margin="2"/>
                        <Button x:Name="EvaluateYuNetButton" Content="计算漏检率" Click="EvaluateYuNet_Click" Padding="10,5" Margin="2"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" x:Name="YuNetGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" SelectionMode="Extended" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="检测数" Binding="{Binding DetectedFaceCount}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="人工数" Binding="{Binding ExpectedFaceCount, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="场景标签" Binding="{Binding Categories, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" x:Name="YuNetResult" Margin="2,8,2,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <ProgressBar x:Name="WorkProgress" DockPanel.Dock="Right" Width="240" Height="14" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="Status" Text="就绪" Foreground="#555"/>
        </DockPanel>
    </Grid>
</Window>
