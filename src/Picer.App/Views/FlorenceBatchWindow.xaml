<Window x:Class="Picer.App.Views.FlorenceBatchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Florence 本地批量描述任务" Width="1080" Height="700" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10" Margin="0,0,0,10"><TextBlock TextWrapping="Wrap" Text="任务完全离线。新结果先进入“待审阅”，只有用户接受后才会进入主搜索；拒绝项在源文件未变化时不会自动重复处理。"/></Border>
    <WrapPanel DockPanel.Dock="Top"><TextBlock Text="本次最多：" VerticalAlignment="Center"/><TextBox x:Name="LimitBox" Text="20" Width="60"/><TextBlock Text=" 张" VerticalAlignment="Center"/><ComboBox x:Name="TaskBox" Width="130" Margin="10,0" SelectedIndex="0"><ComboBoxItem Content="简短描述"/><ComboBoxItem Content="详细描述"/><ComboBoxItem Content="OCR"/></ComboBox><Button x:Name="StartButton" Content="处理未完成图片" Click="Start_Click" Padding="12,5"/><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Padding="12,5" Margin="8,0"/><Button Content="刷新审阅列表" Click="Refresh_Click" Padding="12,5"/><Button Content="保存审阅" Click="SaveReview_Click" Padding="12,5" Margin="8,0"/></WrapPanel>
    <ProgressBar DockPanel.Dock="Top" x:Name="Progress" Height="12" Margin="0,10,0,4"/><TextBlock DockPanel.Dock="Top" x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="Rows" AutoGenerateColumns="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="接受并进入搜索" Binding="{Binding Accepted}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding State}" IsReadOnly="True" Width="80"/><DataGridTextColumn Header="任务" Binding="{Binding Task}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="描述/OCR" Binding="{Binding Text}" IsReadOnly="True" Width="360"/><DataGridTextColumn Header="图片" Binding="{Binding Path}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="设备" Binding="{Binding Provider}" IsReadOnly="True" Width="80"/></DataGrid.Columns></DataGrid>
  </DockPanel>
</Window>
