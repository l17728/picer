<Window x:Class="Picer.App.Views.DiagnosticCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Picer 诊断中心" Width="980" Height="700" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10" Margin="0,0,0,10"><TextBlock TextWrapping="Wrap" Text="诊断报告不包含原图、图片路径或凭据。诊断包中的日志会移除 Windows 路径，并遮盖 token、password、API key 和 Authorization。只有明确标为“可清理”的缓存才能从这里删除。"/></Border>
    <WrapPanel DockPanel.Dock="Top"><Button x:Name="CheckButton" Content="运行完整健康检查" Click="Check_Click" Padding="12,5"/><Button Content="导出 JSON…" Click="Json_Click" Padding="12,5" Margin="8,0"/><Button Content="导出 CSV…" Click="Csv_Click" Padding="12,5"/><Button Content="生成脱敏诊断包…" Click="Package_Click" Padding="12,5" Margin="8,0"/><Button Content="刷新缓存" Click="RefreshCaches_Click" Padding="12,5"/></WrapPanel>
    <ProgressBar DockPanel.Dock="Top" x:Name="Progress" Height="12" Margin="0,10,0,4"/><TextBlock DockPanel.Dock="Top" x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TabControl>
      <TabItem Header="健康检查"><DataGrid x:Name="Components" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="组件" Binding="{Binding Name}" Width="250"/><DataGridCheckBoxColumn Header="就绪" Binding="{Binding Ready}" Width="70"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/><DataGridTextColumn Header="许可证" Binding="{Binding License}" Width="130"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="缓存管理"><DockPanel><Button DockPanel.Dock="Bottom" Content="清理选中缓存" Click="ClearCache_Click" HorizontalAlignment="Right" Padding="14,6" Margin="8"/><DataGrid x:Name="Caches" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/><DataGridCheckBoxColumn Header="允许清理" Binding="{Binding CanClear}" Width="80"/><DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="240"/><DataGridTextColumn Header="位置" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
