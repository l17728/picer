<Window x:Class="Picer.App.StorageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存储与 WebDAV 设置" Width="650" Height="590" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="存储配置"/>
        <Grid Grid.Row="1" Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="存储类型" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="StorageType" SelectionChanged="StorageType_SelectionChanged"><ComboBoxItem Content="本地文件" Tag="local"/><ComboBoxItem Content="WebDAV" Tag="webdav"/></ComboBox></Grid>
        <Grid Grid.Row="2" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="WebDAV 服务器" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ServerUrl" ToolTip="例如 https://dav.example.com"/></Grid>
        <Grid Grid.Row="3" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="基础路径" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="BasePath" ToolTip="例如 /photos"/></Grid>
        <Grid Grid.Row="4" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="用户名" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="Username"/></Grid>
        <Grid Grid.Row="5" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="密码" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><PasswordBox x:Name="Password"/><TextBlock x:Name="PasswordStatus" FontSize="11" Foreground="#666" Margin="0,3,0,0"/></StackPanel></Grid>
        <CheckBox Grid.Row="6" x:Name="CacheEnabled" Content="启用远程文件本地缓存" Margin="150,8,0,4"/>
        <Grid Grid.Row="7" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="缓存目录" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="选择…" Click="ChooseCache_Click" Padding="8,3" Margin="6,0,0,0"/><TextBox x:Name="CacheDirectory"/></DockPanel></Grid>
        <Grid Grid.Row="8" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="缓存容量（GB）" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="CacheSizeGb" Width="100" HorizontalAlignment="Left"/></Grid>
        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="150,10,0,6">
            <Button x:Name="TestButton" Content="测试 WebDAV 连接" Click="TestConnection_Click" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="删除已保存密码" Click="DeletePassword_Click" Padding="10,5"/>
        </StackPanel>
        <Border Grid.Row="10" Background="#F3F7FC" BorderBrush="#C8D8EA" BorderThickness="1" Padding="10" Margin="0,8">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Text="WebDAV 密码只保存到 Windows 凭据管理器，不写入配置文件、数据库或日志。"/>
        </Border>
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="14,6" Margin="4"/>
            <Button Content="保存并立即应用" Click="Save_Click" Padding="14,6" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>
